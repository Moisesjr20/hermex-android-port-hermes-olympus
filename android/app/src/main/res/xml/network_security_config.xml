<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy — defense in depth.

  OLYMPUS is a native Android client for a self-hosted Hermes server. The server
  typically runs on a LAN at the user's own IP (e.g. http://192.168.x.x:8080),
  so cleartext HTTP MUST be allowed. But permitting cleartext globally
  (usesCleartextTraffic=true) exposes the app to downgrade attacks over the
  public internet.

  This policy:
  - Keeps TLS strict by default for arbitrary hostnames.
  - Allows cleartext ONLY for private-network ranges and local hostnames the
    user is realistically targeting (RFC 1918 + loopback + .local mDNS).

  Reference: https://developer.android.com/training/articles/security-config
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Loopback -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- RFC 1918 private ranges -->
        <domain-prefix>10.</domain-prefix>
        <domain-prefix>192.168.</domain-prefix>
        <!-- 172.16.0.0/12 -->
        <domain-prefix>172.16.</domain-prefix>
        <domain-prefix>172.17.</domain-prefix>
        <domain-prefix>172.18.</domain-prefix>
        <domain-prefix>172.19.</domain-prefix>
        <domain-prefix>172.20.</domain-prefix>
        <domain-prefix>172.21.</domain-prefix>
        <domain-prefix>172.22.</domain-prefix>
        <domain-prefix>172.23.</domain-prefix>
        <domain-prefix>172.24.</domain-prefix>
        <domain-prefix>172.25.</domain-prefix>
        <domain-prefix>172.26.</domain-prefix>
        <domain-prefix>172.27.</domain-prefix>
        <domain-prefix>172.28.</domain-prefix>
        <domain-prefix>172.29.</domain-prefix>
        <domain-prefix>172.30.</domain-prefix>
        <domain-prefix>172.31.</domain-prefix>
        <!-- Link-local (169.254/16) -->
        <domain-prefix>169.254.</domain-prefix>
        <!-- mDNS / Bonjour (.local) -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
